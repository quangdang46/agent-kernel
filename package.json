{
  "name": "agent-kernel",
  "version": "0.1.0",
  "private": true,
  "description": "Clean-room Claude Code plugin scaffold with Honcho-backed memory",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "bun test",
    "browse": "agent-browser --screenshot-dir .agent-kernel/artifacts --max-output 12000",
    "verify:browse": "bun run src/scripts/verify-browse.ts",
    "verify:honcho": "bun run src/scripts/verify-honcho.ts",
    "honcho": "bun run src/scripts/honcho-cli.ts"
  },
  "dependencies": {
    "@honcho-ai/sdk": "2.1.1",
    "agent-browser": "0.26.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.9.3"
  }
}
